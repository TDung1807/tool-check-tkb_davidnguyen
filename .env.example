# ============================================================
# TDTU Calendar Bot – Multi-user Configuration
# ============================================================

# ---------- Telegram Bot ----------
TELEGRAM_BOT_TOKEN=your_bot_token
# Webhook settings (used by webhook_app.py)
TELEGRAM_WEBHOOK_URL=https://tool-check-tkb-davidnguyen.onrender.com/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=your_random_secret_1_to_256_chars

# ---------- Supabase (multi-user database) ----------
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_KEY=your_service_role_key

# ---------- Encryption ----------
# Fernet key for encrypting user credentials at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_fernet_key

# ---------- Google OAuth2 (per-user Calendar) ----------
# Content of client_secret.json from Google Cloud Console.
# Create OAuth 2.0 Client ID (Web application) at:
#   https://console.cloud.google.com/apis/credentials
# Set redirect URI to: https://tool-check-tkb-davidnguyen.onrender.com/api/setup/google/callback
GOOGLE_OAUTH_CLIENT_JSON={"web":{"client_id":"...","client_secret":"...","redirect_uris":["..."],"auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}}

# ---------- Smart Paste (optional) ----------
GEMINI_API_KEY=
# Override if the selected model is unavailable for your Google AI project.
GEMINI_MODEL=gemini-3.1-flash-lite

# ---------- App settings ----------
APP_TIMEZONE=Asia/Ho_Chi_Minh

# ---------- Crawler settings ----------
# Number of future weeks to crawl beyond current week.
CRAWLER_WEEKS_AHEAD=2
# Enable fallback source for exam crawler
EXAM_SOURCE_FALLBACK_ELEARNING=true
# Comma-separated exam type filters
TARGET_EXAM_TYPES=midterm,final
